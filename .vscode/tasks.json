{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Python: 현재 파일 실행",
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": ["${file}"],
      "options": {
        "cwd": "${fileDirname}"
      },
      "presentation": {
        "clear": true,
        "echo": true,
        "focus": true,
        "panel": "dedicated",
        "reveal": "always"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Ruff: 검사",
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": ["-m", "ruff", "check", "."],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Ruff: 포맷 검사",
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": ["-m", "ruff", "format", "--check", "."],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Check: 전체",
      "dependsOrder": "sequence",
      "dependsOn": ["Ruff: 검사", "Ruff: 포맷 검사"],
      "problemMatcher": []
    }
  ]
}
