{
  "python.defaultInterpreterPath": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
  "python.terminal.activateEnvironment": true,
  "python.terminal.executeInFileDir": true,
  "python.analysis.typeCheckingMode": "basic",
  "python.analysis.diagnosticMode": "openFilesOnly",
  "python.analysis.exclude": ["**/.venv/**", "**/.cph/**"],
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["tests"],
  "python.testing.cwd": "${workspaceFolder}",
  "python.testing.unittestEnabled": false,
  "ruff.importStrategy": "fromEnvironment",
  "ruff.configurationPreference": "filesystemFirst",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "files.exclude": {
    "**/.venv": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true
  },
  "files.watcherExclude": {
    "**/.venv/**": true
  },
  "search.exclude": {
    "**/.venv": true,
    "**/.cph": true
  },
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    },
    "editor.insertSpaces": true,
    "editor.tabSize": 4,
    "editor.rulers": [100]
  },
  "cph.general.defaultLanguage": "python",
  "cph.general.menuChoices": "python",
  "cph.general.includeProblemIndex": true,
  "cph.general.timeOut": 5000,
  "cph.language.python.Command": "C:\\dev\\ps-python-for-victus\\.venv\\Scripts\\python.exe",
  "cph.general.defaultLanguageTemplateFileLocation": "C:\\dev\\ps-python-for-victus\\templates\\solution.py",
  "code-runner.executorMap": {
    "python": "\"$pythonPath\" -u \"$fullFileName\""
  },
  "code-runner.fileDirectoryAsCwd": true,
  "code-runner.runInTerminal": true
}
